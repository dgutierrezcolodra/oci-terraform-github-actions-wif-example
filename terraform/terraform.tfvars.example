# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is ignored by git for security

# Required: OCID of the compartment where resources will be created
compartment_id = "ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: OCI region (default: us-ashburn-1)
# oci_region = "eu-frankfurt-1"

# Optional: OCI CLI profile name (default: DEFAULT)
# oci_profile = "DEFAULT"

# Optional: Custom bucket name (default: terraform-validation-bucket)
# bucket_name = "my-validation-bucket"
